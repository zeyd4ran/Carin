{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Carin API",
      "type": "shell",
      "command": "npm",
      "args": ["run", "dev", "--workspace=@workspace/api-server"],
      "options": {
        "env": {
          "PORT": "5000",
          "CARIN_STORAGE": "memory"
        }
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "carin-api",
        "pattern": {
          "regexp": ".*"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "Server listening"
        }
      }
    },
    {
      "label": "Carin web",
      "type": "shell",
      "command": "npm",
      "args": ["run", "dev", "--workspace=@workspace/carin"],
      "options": {
        "env": {
          "PORT": "5173",
          "BASE_PATH": "/",
          "LOCAL_API_PROXY": "1",
          "API_PORT": "5000"
        }
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "carin-web",
        "pattern": {
          "regexp": ".*"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "Local:"
        }
      }
    },
    {
      "label": "Carin: Start full stack",
      "dependsOn": ["Carin API", "Carin web"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}